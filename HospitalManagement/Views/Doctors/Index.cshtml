@model IEnumerable<HospitalManagement.Models.Doctor>

@{
    ViewData["Title"] = "الأطباء";
}

<h1 class="text-primary">👨‍⚕️ إدارة الأطباء</h1>

<p>
    <a asp-action="Create" class="btn btn-success">
        ➕ إضافة طبيب جديد
    </a>
</p>

<table class="table table-bordered table-hover table-striped">

    <thead class="table-primary">

        <tr>
            <th>@Html.DisplayNameFor(model => model.DoctorName)</th>
            <th>@Html.DisplayNameFor(model => model.Specialization)</th>
            <th>@Html.DisplayNameFor(model => model.Phone)</th>
            <th>@Html.DisplayNameFor(model => model.Email)</th>
            <th>القسم</th>
            <th width="220">العمليات</th>
        </tr>

    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.DoctorName</td>

                <td>@item.Specialization</td>

                <td>@item.Phone</td>

                <td>@item.Email</td>

                <td>
                    @(item.Department?.DepartmentName ?? "-")
                </td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.DoctorId"
                       class="btn btn-warning btn-sm">
                        ✏️ تعديل
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.DoctorId"
                       class="btn btn-info btn-sm text-white">
                        👁 التفاصيل
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.DoctorId"
                       class="btn btn-danger btn-sm">
                        🗑 حذف
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>