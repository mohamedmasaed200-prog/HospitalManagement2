@model HospitalManagement.Models.Doctor

@{
    ViewData["Title"] = "إضافة طبيب";
}

<h1 class="text-success">👨‍⚕️ إضافة طبيب جديد</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="DoctorName" class="form-label"></label>
                <input asp-for="DoctorName"
                       class="form-control"
                       placeholder="أدخل اسم الطبيب" />
                <span asp-validation-for="DoctorName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Specialization" class="form-label"></label>
                <input asp-for="Specialization"
                       class="form-control"
                       placeholder="أدخل التخصص" />
                <span asp-validation-for="Specialization" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone"
                       class="form-control"
                       placeholder="09XXXXXXXX" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="doctor@hospital.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DepartmentId" class="form-label"></label>

                <select asp-for="DepartmentId"
                        asp-items="ViewBag.DepartmentId"
                        class="form-select">

                    <option value="">-- اختر القسم --</option>

                </select>

                <span asp-validation-for="DepartmentId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">
                ➕ إضافة الطبيب
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                ↩ العودة للقائمة
            </a>

        </form>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}