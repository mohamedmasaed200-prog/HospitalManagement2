@model HospitalManagement.Models.Patient

@{
    ViewData["Title"] = "إضافة مريض";
}

<h1 class="text-success">🧑 إضافة مريض جديد</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName"
                       class="form-control"
                       placeholder="أدخل اسم المريض" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age" class="form-label"></label>
                <input asp-for="Age"
                       class="form-control"
                       placeholder="أدخل العمر" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gender" class="form-label"></label>

                <select asp-for="Gender" class="form-select">
                    <option value="">-- اختر النوع --</option>
                    <option value="ذكر">ذكر</option>
                    <option value="أنثى">أنثى</option>
                </select>

                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone"
                       class="form-control"
                       placeholder="09XXXXXXXX" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address"
                       class="form-control"
                       placeholder="أدخل العنوان" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BloodGroup" class="form-label"></label>

                <select asp-for="BloodGroup" class="form-select">
                    <option value="">-- اختر فصيلة الدم --</option>
                    <option>A+</option>
                    <option>A-</option>
                    <option>B+</option>
                    <option>B-</option>
                    <option>AB+</option>
                    <option>AB-</option>
                    <option>O+</option>
                    <option>O-</option>
                </select>

                <span asp-validation-for="BloodGroup" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">
                ➕ إضافة المريض
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                ↩ العودة للقائمة
            </a>

        </form>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}