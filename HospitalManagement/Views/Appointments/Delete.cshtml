@model HospitalManagement.Models.Appointment

@{
    ViewData["Title"] = "حذف الموعد";
}

<h1 class="text-danger">🗑 حذف الموعد</h1>

<div class="alert alert-warning">
    <h4>هل أنت متأكد من حذف هذا الموعد؟</h4>
</div>

<div class="card shadow">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.AppointmentDate)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.AppointmentDate)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Reason)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Reason)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.PatientId)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.PatientId)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.DoctorId)
            </dt>

            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.DoctorId)
            </dd>

        </dl>

        <form asp-action="Delete">

            <input type="hidden" asp-for="AppointmentId" />

            <button type="submit" class="btn btn-danger">
                🗑 حذف
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                ↩ العودة للقائمة
            </a>

        </form>

    </div>

</div>