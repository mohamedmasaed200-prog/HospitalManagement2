@model HospitalManagement.Models.Appointment

@{
    ViewData["Title"] = "إضافة موعد";
}

<h1 class="text-success">📅 إضافة موعد جديد</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="AppointmentDate" class="form-label"></label>
                <input asp-for="AppointmentDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="AppointmentDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label"></label>
                <input asp-for="Reason" class="form-control" placeholder="أدخل سبب الزيارة" />
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PatientId" class="form-label"></label>
                <select asp-for="PatientId"
                        asp-items="ViewBag.PatientId"
                        class="form-select">
                    <option value="">-- اختر المريض --</option>
                </select>
                <span asp-validation-for="PatientId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DoctorId" class="form-label"></label>
                <select asp-for="DoctorId"
                        asp-items="ViewBag.DoctorId"
                        class="form-select">
                    <option value="">-- اختر الطبيب --</option>
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">
                ➕ إضافة الموعد
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                ↩ العودة للقائمة
            </a>

        </form>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}