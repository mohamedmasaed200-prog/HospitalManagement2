<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - نظام إدارة المستشفى</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HospitalManagement.styles.css" asp-append-version="true" />
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">

        <div class="container">

            <a class="navbar-brand d-flex align-items-center"
               asp-controller="Home"
               asp-action="Index">

                <img src="~/images/logo.png"
                     width="45"
                     height="45"
                     class="rounded-circle ms-2" />

                <span class="fw-bold fs-5">
                    نظام إدارة المستشفى
                </span>

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            🏠 الرئيسية
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Departments" asp-action="Index">
                            🏥 الأقسام
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Doctors" asp-action="Index">
                            👨‍⚕️ الأطباء
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Patients" asp-action="Index">
                            🧑 المرضى
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointments" asp-action="Index">
                            📅 المواعيد
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">
                            ℹ️ حول النظام
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-warning" asp-controller="Account" asp-action="Logout">
                            🚪 تسجيل الخروج
                        </a>
                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="border-top footer text-center text-muted mt-5 py-3">

        <div class="container">

            <strong>🏥 نظام إدارة المستشفى</strong>

            <br />

            جميع الحقوق محفوظة © 2026

            <br />

            إعداد الطالب:
            <strong>محمد أبوعبيدة علي مساعد</strong>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>