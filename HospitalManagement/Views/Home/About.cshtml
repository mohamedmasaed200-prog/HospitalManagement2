@{
    ViewData["Title"] = "حول النظام";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h2>🏥 حول نظام إدارة المستشفى</h2>
    </div>

    <div class="card-body">

        <h4>نبذة عن النظام</h4>

        <p>
            نظام إدارة المستشفى هو تطبيق ويب تم تطويره باستخدام
            <strong>ASP.NET Core MVC</strong>
            بهدف تسهيل إدارة المستشفيات وتنظيم بيانات المرضى والأطباء والأقسام والمواعيد
            من خلال واجهة سهلة الاستخدام وقاعدة بيانات منظمة.
        </p>

        <hr />

        <h4>أهداف النظام</h4>

        <ul>
            <li>إدارة بيانات المرضى.</li>
            <li>إدارة بيانات الأطباء.</li>
            <li>تنظيم أقسام المستشفى.</li>
            <li>إدارة المواعيد بين الأطباء والمرضى.</li>
            <li>توفير واجهة سهلة وسريعة للمستخدم.</li>
            <li>تسهيل الوصول إلى البيانات وإدارتها إلكترونياً.</li>
        </ul>

        <hr />

        <h4>التقنيات المستخدمة</h4>

        <ul>
            <li>ASP.NET Core MVC</li>
            <li>C#</li>
            <li>Entity Framework Core</li>
            <li>SQLite</li>
            <li>Bootstrap 5</li>
            <li>Visual Studio 2022</li>
            <li>Git & GitHub</li>
            <li>Railway Cloud Platform</li>
        </ul>

        <hr />

        <h4>فريق المشروع</h4>

        <table class="table table-bordered table-striped">

            <tr>
                <th width="30%">اسم المشروع</th>
                <td>نظام إدارة المستشفى</td>
            </tr>

            <tr>
                <th>المشرف على المشروع</th>
                <td>محمد أبوعبيدة علي</td>
            </tr>

            <tr>
                <th>أعضاء فريق المشروع</th>
                <td>
                    <ul class="mb-0">
                        <li>أماني</li>
                        <li>هيام</li>
                        <li>سعاد</li>
                        <li>ملاذ</li>
                    </ul>
                </td>
            </tr>

            <tr>
                <th>الكلية</th>
                <td>كلية علوم الحاسوب وتقانة المعلومات</td>
            </tr>

            <tr>
                <th>الجامعة</th>
                <td>جامعة القضارف</td>
            </tr>

            <tr>
                <th>السنة</th>
                <td>2026</td>
            </tr>

        </table>

    </div>

</div>